<Project>
  <Target Name="StampOceanGlassBuild" BeforeTargets="GetAssemblyAttributes" Condition="'$(MSBuildProjectName)' == 'ExcelSticker.Wpf'">
    <PropertyGroup>
      <_BuildCommit>unavailable</_BuildCommit><_BuildBranch>source snapshot</_BuildBranch>
      <_BuildUtc>$([System.DateTime]::UtcNow.ToString('O'))</_BuildUtc>
    </PropertyGroup>
    <Exec Command="git -C &quot;$(MSBuildThisFileDirectory)&quot; rev-parse --short=12 HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="Low" StandardErrorImportance="Low" Condition="Exists('$(MSBuildThisFileDirectory).git')">
      <Output TaskParameter="ConsoleOutput" ItemName="_CommitLines"/><Output TaskParameter="ExitCode" PropertyName="_CommitExit"/>
    </Exec>
    <Exec Command="git -C &quot;$(MSBuildThisFileDirectory)&quot; branch --show-current" ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="Low" StandardErrorImportance="Low" Condition="'$(_CommitExit)' == '0'">
      <Output TaskParameter="ConsoleOutput" ItemName="_BranchLines"/>
    </Exec>
    <PropertyGroup Condition="'$(_CommitExit)' == '0'">
      <_BuildCommit>@(_CommitLines)</_BuildCommit>
      <_BuildBranch Condition="'@(_BranchLines)' != ''">@(_BranchLines)</_BuildBranch>
      <_BuildBranch Condition="'@(_BranchLines)' == ''">detached HEAD</_BuildBranch>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="BuildCommit" Value="$(_BuildCommit)"/>
      <AssemblyMetadata Include="BuildBranch" Value="$(_BuildBranch)"/>
      <AssemblyMetadata Include="BuildUtc" Value="$(_BuildUtc)"/>
      <AssemblyMetadata Include="BuildConfiguration" Value="$(Configuration)"/>
    </ItemGroup>
  </Target>
</Project>
