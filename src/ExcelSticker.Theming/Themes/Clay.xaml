<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:clay="clr-namespace:ExcelSticker.Theming">
 <!-- Resource defaults must be style setters, not constructor-local values: local values
      outrank template triggers and used to block pressed/depth/edge overrides. -->
 <Style TargetType="clay:ClayChrome">
  <Setter Property="SurfaceShadowTint" Value="{DynamicResource ClaySurfaceShadowTint}"/>
  <Setter Property="Lighting" Value="{DynamicResource ClayLighting}"/><Setter Property="ShadeColor" Value="{DynamicResource ClayShadeColor}"/>
  <Setter Property="LightElevation" Value="{DynamicResource ClayLightElevation}"/><Setter Property="Curvature" Value="{DynamicResource ClayCurvature}"/>
  <Setter Property="Gloss" Value="{DynamicResource ClayGloss}"/><Setter Property="GlossFocus" Value="{DynamicResource ClayGlossFocus}"/>
  <Setter Property="RimOpacity" Value="{DynamicResource ClayRimOpacity}"/>
  <Setter Property="Inset" Value="{DynamicResource ClayInset}"/><Setter Property="Highlight" Value="{DynamicResource ClayHighlight}"/>
  <Setter Property="Shade" Value="{DynamicResource ClayShade}"/><Setter Property="LightAngle" Value="{DynamicResource ClayLightAngle}"/>
  <Setter Property="LineWidth" Value="{DynamicResource ClayBorder}"/><Setter Property="Edge" Value="{DynamicResource ClayEdge}"/>
 </Style>
 <Style TargetType="Window">
  <Setter Property="FontFamily" Value="{DynamicResource ClayFontFamily}"/><Setter Property="FontSize" Value="{DynamicResource ClayFontSize}"/>
  <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource ClayCanvas}"/>
  <Setter Property="UseLayoutRounding" Value="True"/><Setter Property="SnapsToDevicePixels" Value="True"/>
  <Setter Property="TextOptions.TextFormattingMode" Value="Display"/><Setter Property="TextOptions.TextRenderingMode" Value="Auto"/>
 </Style>
 <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource ClaySmallFontSize}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Margin" Value="1,0,0,4"/></Style>
 <Style TargetType="clay:ClayCard">
  <Setter Property="Background" Value="{DynamicResource ClaySurface}"/><Setter Property="BorderBrush" Value="{DynamicResource ClayEdge}"/>
  <Setter Property="CornerRadius" Value="{DynamicResource ClayCardRadius}"/><Setter Property="Padding" Value="{DynamicResource ClayCardPadding}"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="clay:ClayCard"><Grid Background="Transparent">
   <!-- Both shadow leaves are decorative siblings, never ancestors of content. -->
   <clay:ClayChrome Style="{StaticResource {x:Type clay:ClayChrome}}" x:Name="Ambient" Fill="{TemplateBinding Background}" Radius="{TemplateBinding CornerRadius}" Inset="0" LineWidth="0" Shadow="{DynamicResource ClayAmbientShadow}"/>
   <clay:ClayChrome Style="{StaticResource {x:Type clay:ClayChrome}}" x:Name="Surface" Fill="{TemplateBinding Background}" Radius="{TemplateBinding CornerRadius}" Edge="{TemplateBinding BorderBrush}" Shadow="{DynamicResource ClayShadow}"/>
   <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
  </Grid></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Card" TargetType="clay:ClayCard" BasedOn="{StaticResource {x:Type clay:ClayCard}}"><Setter Property="Margin" Value="{DynamicResource ClayCardMargin}"/></Style>
 <Style x:Key="InnerPlate" TargetType="clay:ClayCard" BasedOn="{StaticResource {x:Type clay:ClayCard}}">
  <Setter Property="Padding" Value="{DynamicResource ClayPlatePadding}"/><Setter Property="CornerRadius" Value="{DynamicResource ClayPlateRadius}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="clay:ClayCard"><Grid Background="Transparent">
   <clay:ClayChrome Style="{StaticResource {x:Type clay:ClayChrome}}" Fill="{TemplateBinding Background}" Radius="{TemplateBinding CornerRadius}" x:Name="PlateSurface" Edge="{TemplateBinding BorderBrush}" Relief="{DynamicResource ClayPlateRelief}" Shadow="{DynamicResource ClayPlateShadow}" Inset="{DynamicResource ClayPlateInset}"/>
   <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
  </Grid></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="Button">
  <Setter Property="Padding" Value="{DynamicResource ClayControlPadding}"/><Setter Property="Margin" Value="{DynamicResource ClayButtonMargin}"/>
  <Setter Property="Background" Value="{DynamicResource ClayButton}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Background="Transparent">
   <clay:ClayChrome Style="{StaticResource {x:Type clay:ClayChrome}}" x:Name="Ambient" Inset="0" LineWidth="0" Fill="{TemplateBinding Background}" Radius="{DynamicResource ClayButtonRadius}" Shadow="{DynamicResource ClayControlAmbientShadow}"/>
   <clay:ClayChrome Style="{StaticResource {x:Type clay:ClayChrome}}" x:Name="Surface" Inset="{DynamicResource ClayControlInset}" Fill="{TemplateBinding Background}" Radius="{DynamicResource ClayButtonRadius}" Shadow="{DynamicResource ClayControlShadow}"/>
   <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
   <clay:ClayChrome Style="{StaticResource {x:Type clay:ClayChrome}}" Fill="Transparent" Inset="0" RimOpacity="1" x:Name="Focus" IsHitTestVisible="False" Radius="{DynamicResource ClayButtonRadius}" LineWidth="2" Edge="Transparent"/>
  </Grid><ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="LineWidth" Value="{DynamicResource ClayHoverBorder}"/></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter TargetName="Ambient" Property="Visibility" Value="Collapsed"/><Setter TargetName="Surface" Property="Relief" Value="Inset"/><Setter TargetName="Surface" Property="Shadow" Value="{x:Null}"/><Setter TargetName="Surface" Property="Shade" Value="{DynamicResource ClayPressedShade}"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Edge" Value="{DynamicResource ClayFocus}"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Ambient" Property="Visibility" Value="Collapsed"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter TargetName="Surface" Property="Shadow" Value="{x:Null}"/></Trigger>
  </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ClayHover}"/></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource ClayPressed}"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource ClaySurface}"/></Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="{DynamicResource ClayPrimary}"/><Setter Property="Foreground" Value="{DynamicResource ClayPrimaryInk}"/>
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ClayPrimaryHover}"/></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource ClayPrimaryPressed}"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource ClaySurface}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Trigger>
  </Style.Triggers>
 </Style>
 <Style TargetType="TextBox">
  <Setter Property="Padding" Value="{DynamicResource ClayControlPadding}"/><Setter Property="Margin" Value="{DynamicResource ClayFieldMargin}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
  <Setter Property="Background" Value="{DynamicResource ClayInput}"/><Setter Property="CaretBrush" Value="{DynamicResource Ink}"/><Setter Property="SelectionBrush" Value="{DynamicResource ClaySelection}"/><Setter Property="SelectionTextBrush" Value="{DynamicResource Ink}"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Grid Background="Transparent">
   <clay:ClayChrome Style="{StaticResource {x:Type clay:ClayChrome}}" Fill="{TemplateBinding Background}" Radius="{DynamicResource ClayInputRadius}" Relief="Inset" Inset="{DynamicResource ClayInputInset}" Highlight="{DynamicResource ClayInputHighlight}" Shade="{DynamicResource ClayInputShade}"/>
   <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Background="{TemplateBinding Background}" RenderOptions.ClearTypeHint="Enabled"/>
   <clay:ClayChrome Style="{StaticResource {x:Type clay:ClayChrome}}" Fill="Transparent" Inset="0" RimOpacity="1" x:Name="Focus" IsHitTestVisible="False" Radius="{DynamicResource ClayInputRadius}" Edge="Transparent" LineWidth="2"/>
  </Grid><ControlTemplate.Triggers>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Edge" Value="{DynamicResource ClayFocus}"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Trigger>
  </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="{DynamicResource ClayControlPadding}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" CornerRadius="{DynamicResource ClayInputRadius}" Padding="{TemplateBinding Padding}" Background="{DynamicResource ClaySurface}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource ClaySelection}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="{DynamicResource ClayFocus}"/><Setter TargetName="Item" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ComboBox">
  <Setter Property="Padding" Value="{DynamicResource ClayControlPadding}"/><Setter Property="Margin" Value="{DynamicResource ClayComboMargin}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid Background="Transparent">
   <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent"><clay:ClayChrome Style="{StaticResource {x:Type clay:ClayChrome}}" Fill="{DynamicResource ClayButton}" Radius="{DynamicResource ClayInputRadius}" Inset="{DynamicResource ClayControlInset}" Shadow="{DynamicResource ClayControlShadow}"/><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,3" FontSize="18" Foreground="{DynamicResource Ink}"/></Grid></ControlTemplate></ToggleButton.Template></ToggleButton>
   <Border Margin="0,0,30,0" IsHitTestVisible="False"><ContentPresenter Margin="{TemplateBinding Padding}" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/></Border>
   <clay:ClayChrome Style="{StaticResource {x:Type clay:ClayChrome}}" Fill="Transparent" Inset="0" RimOpacity="1" x:Name="Focus" IsHitTestVisible="False" Radius="{DynamicResource ClayInputRadius}" LineWidth="2" Edge="Transparent"/>
   <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
    <Border Background="{DynamicResource ClaySurface}" BorderBrush="{DynamicResource ClayEdge}" BorderThickness="1" CornerRadius="{DynamicResource ClayInputRadius}" Padding="5" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="300" Background="{DynamicResource ClaySurface}" RenderOptions.ClearTypeHint="Enabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border>
   </Popup>
  </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Focus" Property="Edge" Value="{DynamicResource ClayFocus}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="CheckBox">
  <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Margin" Value="0,4,0,8"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal" Background="Transparent">
   <Grid Background="Transparent" Width="24" Height="24" Margin="0,0,9,0"><clay:ClayChrome Style="{StaticResource {x:Type clay:ClayChrome}}" x:Name="Box" Inset="{DynamicResource ClaySmallInset}" Fill="{DynamicResource ClayButton}" Radius="4" Shadow="{DynamicResource ClayControlShadow}"/><TextBlock x:Name="Tick" Text="✓" Foreground="{DynamicResource ClayPrimaryInk}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/><clay:ClayChrome Style="{StaticResource {x:Type clay:ClayChrome}}" Fill="Transparent" Inset="0" RimOpacity="1" x:Name="Focus" Radius="4" Edge="Transparent" LineWidth="2"/></Grid>
   <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
  </StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Fill" Value="{DynamicResource ClayPrimary}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Edge" Value="{DynamicResource ClayFocus}"/></Trigger>
   <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="Box" Property="Fill" Value="{DynamicResource ClayPrimary}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/><Setter TargetName="Tick" Property="Text" Value="−"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter TargetName="Box" Property="Shadow" Value="{x:Null}"/><Setter TargetName="Box" Property="Fill" Value="{DynamicResource ClaySelection}"/><Setter TargetName="Tick" Property="Foreground" Value="{DynamicResource Muted}"/></Trigger>
  </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="Slider"><Setter Property="Margin" Value="0,4,0,12"/><Setter Property="MinHeight" Value="28"/><Setter Property="IsSnapToTickEnabled" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Margin="8,0" Background="Transparent">
  <Border x:Name="Rail" Height="5" CornerRadius="1" Background="{DynamicResource ClayEdge}" VerticalAlignment="Center"/>
  <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="24" Height="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><clay:ClayChrome Style="{StaticResource {x:Type clay:ClayChrome}}" Fill="{DynamicResource ClayPrimary}" Radius="4" Inset="{DynamicResource ClaySmallInset}" Shadow="{DynamicResource ClayControlShadow}"/><clay:ClayChrome Style="{StaticResource {x:Type clay:ClayChrome}}" Fill="Transparent" Inset="0" RimOpacity="1" x:Name="Focus" Radius="4" Edge="{DynamicResource ClayFocus}" LineWidth="1"/></Grid></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton></Track>
 <Border x:Name="SliderFocus" IsHitTestVisible="False" BorderBrush="Transparent" BorderThickness="2" CornerRadius="4"/>
 </Grid><ControlTemplate.Triggers>
  <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SliderFocus" Property="BorderBrush" Value="{DynamicResource ClayFocus}"/></Trigger>
  <Trigger Property="Orientation" Value="Vertical"><Setter TargetName="Rail" Property="Height" Value="Auto"/><Setter TargetName="Rail" Property="Width" Value="5"/><Setter TargetName="Rail" Property="VerticalAlignment" Value="Stretch"/></Trigger>
 </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ListBox"><Setter Property="Background" Value="{DynamicResource ClaySurface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource ClayEdge}"/><Setter Property="BorderThickness" Value="1"/></Style>
 <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="{DynamicResource ClayControlPadding}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ClayInputRadius}" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ClaySelection}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource ClayFocus}"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource ClaySelection}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Padding" Value="{DynamicResource ClayHeaderPadding}"/><Setter Property="FontSize" Value="{DynamicResource ClaySmallFontSize}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style TargetType="ToolTip"><Setter Property="Background" Value="{DynamicResource ClaySurface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource ClayEdge}"/></Style>
 <Style x:Key="ClayScrollThumb" TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><clay:ClayChrome Style="{StaticResource {x:Type clay:ClayChrome}}" Fill="{DynamicResource ClayEdge}" Radius="3" Inset="{DynamicResource ClaySmallInset}" LineWidth="0"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ScrollBar">
  <Setter Property="Width" Value="14"/><Setter Property="MinHeight" Value="18"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{DynamicResource ClaySurface}"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}">
   <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource ClayScrollThumb}" MinHeight="18"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton>
  </Track></Grid></ControlTemplate></Setter.Value></Setter>
  <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="14"/><Setter Property="MinHeight" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{DynamicResource ClaySurface}"><Track x:Name="PART_Track" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}">
   <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource ClayScrollThumb}" MinWidth="18"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton>
  </Track></Grid></ControlTemplate></Setter.Value></Setter></Trigger></Style.Triggers>
 </Style>
</ResourceDictionary>
