<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LableStudio</AssemblyName>
    <Title>LABLE STUDIO</Title>
    <AssemblyTitle>LABLE STUDIO</AssemblyTitle>
    <Product>LABLE STUDIO</Product>
    <Description>Industrial glass-label preparation and printing</Description>
    <ApplicationIcon>Assets/lable-studio.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/lable-studio.ico" />
    <Resource Include="Assets/lable-studio.png" />
    <ProjectReference Include="../ExcelSticker.Core/ExcelSticker.Core.csproj" />
    <ProjectReference Include="../ExcelSticker.Theming/ExcelSticker.Theming.csproj" />
    <EmbeddedResource Include="company.json" LogicalName="LableStudio.CompanyDefaults.json" />
    <None Update="company.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="company.json" CopyToPublishDirectory="Never" Condition="'$(PublishSingleFile)' == 'true'" />
  </ItemGroup>
</Project>
