<Window x:Class="ExcelSticker.Wpf.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:studio="clr-namespace:ExcelSticker.Wpf.Studio"
 xmlns:clay="clr-namespace:ExcelSticker.Theming;assembly=ExcelSticker.Theming"
 Title="LABLE STUDIO" Icon="pack://application:,,,/LableStudio;component/Assets/lable-studio.ico" Style="{StaticResource {x:Type Window}}" Width="1360" Height="860" MinWidth="1080" MinHeight="640" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
 <Grid Margin="{DynamicResource ClayWorkspaceMargin}" Background="{DynamicResource ClayCanvasTexture}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="6,0,6,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Image x:Name="ApplicationLogo" Width="48" Height="48" Margin="0,0,12,0" Source="{StaticResource ApplicationLogo}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="LABLE STUDIO logo"/>
   <StackPanel Grid.Column="1"><TextBlock Text="LABLE STUDIO" FontSize="23" FontWeight="Bold"/><Button x:Name="BuildInfoButton" Content="Build information" Click="BuildInfo_Click" FontSize="{DynamicResource ClaySmallFontSize}" HorizontalAlignment="Left" Padding="6,3" Margin="0,4,0,0" ToolTip="Version, branch, commit, build time and loaded executable folder"/><TextBlock x:Name="ThemeState" Margin="0,6,0,0" FontSize="{DynamicResource ClaySmallFontSize}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></StackPanel>
   <WrapPanel Grid.Column="2" VerticalAlignment="Center"><Button x:Name="ThemeStudioButton" Content="Theme Studio" Click="ThemeStudio_Click"/></WrapPanel>
  </Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <TextBlock Text="CUTTING LIST" FontSize="22" FontWeight="Bold" Margin="8,0,8,8"/>
   <Grid Margin="8,0,8,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="ORDER NO" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OrderNo" MaxLength="40" TextChanged="Form_Changed" ToolTip="Required for stickers. New cutting rows use this default; imported row metadata is retained." AutomationProperties.Name="Order No"/></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="CUSTOMER" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CustomerName" MaxLength="80" TextChanged="Form_Changed" ToolTip="Required for stickers. Imported customers remain attached to their own rows." AutomationProperties.Name="Customer Name"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="JOB NO · optional" Style="{StaticResource FieldLabel}"/><TextBox x:Name="JobNo" MaxLength="40" TextChanged="Form_Changed" AutomationProperties.Name="Job No"/></StackPanel>
   </Grid>
   <WrapPanel Margin="8,0,8,8"><Button x:Name="SaveExcelButton" Content="Save Excel" Click="SaveExcel_Click" Style="{StaticResource Primary}" ToolTip="Save a formatted .xlsx cutting list · Ctrl+S"/><Button Content="Import Excel / CSV" Click="Import_Click"/><Button Content="Blank Excel template" Click="Template_Click"/><Button Content="Clear sheet" Click="Clear_Click"/><Button x:Name="StickersButton" Content="Stickers / printing" Click="ToggleStickers_Click" ToolTip="Show or hide the inline sticker and printer section; no popup window"/></WrapPanel>
   <clay:ClayCard x:Name="BatchCard" Style="{StaticResource Card}" Background="{DynamicResource ClayPeach}"><StackPanel>
    <TextBlock x:Name="BatchTitle" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <studio:CuttingWorkspace x:Name="CuttingView"/>
   </StackPanel></clay:ClayCard>
   <Expander x:Name="StickersSection" Header="Stickers &amp; printing · expand for live preview, formats and printer settings" IsExpanded="False" Margin="8,4,8,12">
    <StackPanel>
     <WrapPanel Margin="8"><Button Content="Advanced CSV export" Click="ExportCutting_Click"/><Button Content="Sticker layout editor" Click="StickerEditor_Click"/><Button x:Name="EditEntryButton" Content="Edit selected entry details" Click="Edit_Click"/></WrapPanel>
     <Expander x:Name="ManualEntrySection" Header="Manual entry / advanced pane overrides" IsExpanded="False">
     <clay:ClayCard x:Name="EntryCard" Style="{StaticResource Card}" Background="{DynamicResource ClayLavender}"><StackPanel>
      <Grid Margin="{DynamicResource ClaySectionGap}"><TextBlock x:Name="FormTitle" Text="Manual glass entry" FontSize="16" FontWeight="SemiBold"/></Grid>
      <StackPanel x:Name="EntryMetadataOverride" Visibility="Collapsed" Margin="0,0,0,8">
       <TextBlock Text="Selected entry metadata · does not change sheet defaults" Style="{StaticResource FieldLabel}"/>
       <UniformGrid Columns="3">
        <StackPanel><TextBlock Text="ORDER NO" Style="{StaticResource FieldLabel}"/><TextBox x:Name="EntryOrderNo" MaxLength="40" TextChanged="Form_Changed" AutomationProperties.Name="Selected entry order"/></StackPanel>
        <StackPanel><TextBlock Text="CUSTOMER" Style="{StaticResource FieldLabel}"/><TextBox x:Name="EntryCustomerName" MaxLength="80" TextChanged="Form_Changed" AutomationProperties.Name="Selected entry customer"/></StackPanel>
        <StackPanel><TextBlock Text="JOB NO" Style="{StaticResource FieldLabel}"/><TextBox x:Name="EntryJobNo" MaxLength="40" TextChanged="Form_Changed" AutomationProperties.Name="Selected entry job"/></StackPanel>
       </UniformGrid>
      </StackPanel>
      <UniformGrid Columns="1">
       <StackPanel><TextBlock Text="REFERENCE NO" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ReferenceNo" Text="W6* F5" MaxLength="60" TextChanged="Form_Changed" AutomationProperties.Name="Reference No"/></StackPanel>
      </UniformGrid>
      <TextBlock Text="SPECIFICATION  ·  OUTER GLASS + SPACER + INNER GLASS" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="Specification" Text="6MM HD GREY FT GLASS + 12MM ASP + 6MM CLEAR GLASS" MaxLength="240" TextChanged="Form_Changed" AutomationProperties.Name="Glass specification"/>
      <CheckBox x:Name="DoubleGlazed" Content="Outer + inner glass" IsChecked="True" Checked="Mode_Changed" Unchecked="Mode_Changed" Margin="{DynamicResource ClaySectionGap}"/>
      <Grid x:Name="PaneFields"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <clay:ClayCard Style="{StaticResource InnerPlate}" x:Name="OuterFields" Background="{DynamicResource ClayMint}" CornerRadius="{DynamicResource ClayPlateRadius}" Margin="0,0,5,8" BorderBrush="{DynamicResource ClayEdge}"><StackPanel>
        <TextBlock Text="OUTER  /  W1 · H1" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="{DynamicResource ClaySectionGap}"/>
        <UniformGrid Columns="3">
         <StackPanel><TextBlock Text="W1 (mm)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="W1" Text="2550" MaxLength="12" TextChanged="Form_Changed" AutomationProperties.Name="Outer width W1"/></StackPanel>
         <StackPanel><TextBlock Text="H1 (mm)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="H1" Text="2650" MaxLength="12" TextChanged="Form_Changed" AutomationProperties.Name="Outer height H1"/></StackPanel>
         <StackPanel><TextBlock Text="QTY" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OuterQty" Text="4" MaxLength="5" TextChanged="Form_Changed" AutomationProperties.Name="Outer quantity"/></StackPanel>
        </UniformGrid>
        <TextBlock Text="GLASS OVERRIDE (OPTIONAL)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OuterGlass" MaxLength="80" TextChanged="Form_Changed" Margin="0" AutomationProperties.Name="Outer glass override"/>
       </StackPanel></clay:ClayCard>
       <clay:ClayCard Style="{StaticResource InnerPlate}" x:Name="InnerFields" Grid.Column="1" Background="{DynamicResource ClayRose}" CornerRadius="{DynamicResource ClayPlateRadius}" Margin="5,0,0,8" BorderBrush="{DynamicResource ClayEdge}"><StackPanel>
        <TextBlock Text="INNER  /  W2 · H2" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="{DynamicResource ClaySectionGap}"/>
        <UniformGrid Columns="3">
         <StackPanel><TextBlock Text="W2 (mm)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="W2" MaxLength="12" TextChanged="Form_Changed" ToolTip="Blank W2 and H2 use W1 and H1" AutomationProperties.Name="Inner width W2"/></StackPanel>
         <StackPanel><TextBlock Text="H2 (mm)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="H2" MaxLength="12" TextChanged="Form_Changed" ToolTip="Blank W2 and H2 use W1 and H1" AutomationProperties.Name="Inner height H2"/></StackPanel>
         <StackPanel><TextBlock Text="QTY" Style="{StaticResource FieldLabel}"/><TextBox x:Name="InnerQty" MaxLength="5" TextChanged="Form_Changed" ToolTip="Blank uses outer quantity" AutomationProperties.Name="Inner quantity"/></StackPanel>
        </UniformGrid>
        <TextBlock Text="GLASS OVERRIDE (OPTIONAL)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="InnerGlass" MaxLength="80" TextChanged="Form_Changed" Margin="0" AutomationProperties.Name="Inner glass override"/>
       </StackPanel></clay:ClayCard>
      </Grid>
      <TextBlock Text="Blank W2 + H2 reuse W1 + H1. Blank inner Qty reuses outer Qty. The spacer is not printed as a pane." Foreground="{DynamicResource Muted}" FontSize="{DynamicResource ClaySmallFontSize}" TextWrapping="Wrap" Margin="{DynamicResource ClaySectionGap}"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,12,0,0"><Button x:Name="AddButton" Content="+  Add to batch" Style="{StaticResource Primary}" Click="Add_Click"/><Button Content="Preview form" Click="Preview_Click"/><Button x:Name="CancelEditButton" Content="Cancel edit" Click="CancelEdit_Click" Visibility="Collapsed"/></WrapPanel>
      </Grid>
     </StackPanel></clay:ClayCard>
     </Expander>
     <WrapPanel>
     <clay:ClayCard Width="{DynamicResource ClayPreviewCardWidth}" x:Name="StickerPreviewCard" Style="{StaticResource Card}" Background="{DynamicResource ClayBlue}"><StackPanel>
      <Grid Margin="4,2,4,8"><TextBlock Text="Live sticker" FontSize="16" FontWeight="SemiBold"/><Border Background="{DynamicResource ClaySelection}" CornerRadius="2" Padding="6,3" HorizontalAlignment="Right"><TextBlock x:Name="PreviewBadge" Text="LIVE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Ink}"/></Border></Grid>
      <TextBlock x:Name="PreviewSource" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource ClaySmallFontSize}" TextWrapping="Wrap" Margin="4,0,4,8"/>
      <ComboBox x:Name="PreviewExample" SelectedIndex="0" SelectionChanged="PreviewExample_Changed" Margin="4,0,4,8" AutomationProperties.Name="Live preview source"><ComboBoxItem Content="Selected row / SGU example when empty"/><ComboBoxItem Content="SGU example · preview only"/><ComboBoxItem Content="DGU example · preview only"/></ComboBox>
      <ComboBox x:Name="PreviewPane" SelectedIndex="0" SelectionChanged="PreviewPane_Changed" Margin="4,0,4,8" AutomationProperties.Name="Preview pane"><ComboBoxItem Content="Outer glass  ·  W1 / H1"/><ComboBoxItem x:Name="InnerPreviewOption" Content="Inner glass  ·  W2 / H2"/></ComboBox>
      <Border x:Name="StickerPaperFrame" Background="White" BorderBrush="{DynamicResource ClayEdge}" BorderThickness="1" CornerRadius="0" Padding="0" HorizontalAlignment="Center"><ContentControl x:Name="PreviewHost" Width="377.9527559055" Height="264.5669291339"/></Border>
      <WrapPanel HorizontalAlignment="Center" Margin="0,6,0,0"><Button x:Name="PreviousCopyButton" Content="←" Click="PreviousCopy_Click" ToolTip="Previous numbered copy" AutomationProperties.Name="Previous numbered copy"/><TextBlock x:Name="CopyPreviewText" VerticalAlignment="Center" Margin="0,0,10,8"/><Button x:Name="NextCopyButton" Content="→" Click="NextCopy_Click" ToolTip="Next numbered copy" AutomationProperties.Name="Next numbered copy"/></WrapPanel>
      <TextBlock x:Name="PreviewDetails" TextWrapping="Wrap" Margin="4,6,4,0" FontWeight="SemiBold" FontSize="{DynamicResource ClaySmallFontSize}"/>
      <TextBlock x:Name="ValidationMessage" TextWrapping="Wrap" Foreground="{DynamicResource ClayDanger}" Margin="4,4" FontSize="{DynamicResource ClaySmallFontSize}" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <TextBlock Text="100 × 70 mm  ·  actual print stays monochrome" FontSize="{DynamicResource ClaySmallFontSize}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,2"/>
     </StackPanel></clay:ClayCard>
     <clay:ClayCard Width="440" x:Name="PrintSettingsCard" Style="{StaticResource Card}" Background="{DynamicResource ClayYellow}"><StackPanel>
      <TextBlock Text="Prepare a print job" FontSize="16" FontWeight="SemiBold" Margin="{DynamicResource ClaySectionGap}"/>
      <TextBlock Text="STICKER FORMAT" Style="{StaticResource FieldLabel}"/>
      <ComboBox x:Name="LayoutFormat" SelectedIndex="0" SelectionChanged="PrintOptions_Changed" AutomationProperties.Name="Sticker layout format"><ComboBoxItem Content="Automatic · SGU / DGU"/><ComboBoxItem Content="Normal job order"/><ComboBoxItem Content="SGU"/><ComboBoxItem Content="DGU"/></ComboBox>
      <TextBlock Text="QTY ON STICKER · GLASS SR NO / COPY" Style="{StaticResource FieldLabel}"/>
      <TextBlock x:Name="NumberingRule" Text="Sr No 1, Qty 4 → 1/1, 1/2, 1/3, 1/4. Sr No 2 → 2/1, 2/2…" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock Text="ENTRIES" Style="{StaticResource FieldLabel}"/>
      <ComboBox x:Name="PrintScope" SelectedIndex="0" SelectionChanged="PrintOptions_Changed" AutomationProperties.Name="Entries to print"><ComboBoxItem Content="All batch entries"/><ComboBoxItem Content="Selected entry only"/></ComboBox>
      <TextBlock Text="GLASS LAYERS" Style="{StaticResource FieldLabel}"/>
      <ComboBox x:Name="PrintLayers" SelectedIndex="0" SelectionChanged="PrintOptions_Changed" AutomationProperties.Name="Layers to print"><ComboBoxItem Content="Both outer + inner"/><ComboBoxItem Content="Outer / single glass only"/><ComboBoxItem Content="Inner glass only"/></ComboBox>
      <CheckBox x:Name="RepeatQuantity" IsChecked="True" Content="Print all Qty copies of each pane" Margin="0,4,0,8" Checked="Repeat_Changed" Unchecked="Repeat_Changed"/>
      <TextBlock x:Name="PrintSummary" Text="0 pages ready" FontWeight="SemiBold" Margin="{DynamicResource ClaySectionGap}"/>
      <Button x:Name="PrintButton" Content="Prepare print preview  →" Style="{StaticResource Primary}" Click="Print_Click" IsEnabled="False" Margin="{DynamicResource ClaySectionGap}"/>
      <TextBlock Text="Select 100 × 70 mm stock in the printer driver. If dimensions cannot be verified, you can confirm compatibility printing. Always test one label first." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource ClaySmallFontSize}"/>
      <TextBlock Text="Glass SR NO uses the cutting row number. QTY shows Sr No / copy, not copy / total or a repeated total. Each pane starts at copy 1. With all Qty copies off, each chosen pane prints once as Sr No / 1." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource ClaySmallFontSize}" Margin="0,10,0,0"/>
     </StackPanel></clay:ClayCard>
     </WrapPanel>
     <Expander x:Name="PrintPreviewSection" Header="PRINT-JOB PREVIEW · physical sticker pages" IsExpanded="False" Margin="8"><studio:PrintJobPreview x:Name="JobPreview"/></Expander>
    </StackPanel>
   </Expander>
  </StackPanel></ScrollViewer>
  <TextBlock x:Name="Status" Grid.Row="2" Margin="12,8" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</Window>
