<UserControl x:Class="ExcelSticker.Wpf.Studio.CuttingWorkspace"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:clay="clr-namespace:ExcelSticker.Theming;assembly=ExcelSticker.Theming">
 <StackPanel>
  <WrapPanel Margin="0,0,0,8"><Button Content="+ Add specification" Click="AddSpec_Click"/><TextBlock Text="Click to edit · Tab to move · Shift+click to select a range · Ctrl+C / Ctrl+V" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/></WrapPanel>
  <ItemsControl x:Name="GroupsList" ItemsSource="{Binding Groups}"><ItemsControl.ItemTemplate><DataTemplate>
   <clay:ClayCard Style="{StaticResource Card}" Padding="{DynamicResource ClayCardPadding}" Margin="0,0,0,12" Background="{DynamicResource ClaySurface}"><StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="GLASS TYPE" Style="{StaticResource FieldLabel}"/><ComboBox SelectedValue="{Binding GlassType,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content"><ComboBoxItem Content="SGU"/><ComboBoxItem Content="DGU"/></ComboBox></StackPanel>
     <StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="SPECIFICATION" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Specification,UpdateSourceTrigger=PropertyChanged}" MaxLength="240" ToolTip="DGU: outer glass + spacer + inner glass. Complex glass overrides are available under Manual entry."/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="BASE AED / m²" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding BasePrice,UpdateSourceTrigger=PropertyChanged}" MaxLength="20" ToolTip="Rows with blank Price inherit this rate."/></StackPanel>
     <Button Grid.Column="3" Content="Remove spec" Foreground="{DynamicResource ClayDanger}" Click="RemoveSpec_Click" VerticalAlignment="Center" Margin="8,0,0,0"/>
    </Grid>
    <Border BorderBrush="{DynamicResource ClayEdge}" BorderThickness="1" CornerRadius="0" Background="{DynamicResource ClaySurface}">
     <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
      MinHeight="216" MaxHeight="440" RowHeight="{DynamicResource ClaySingleRowHeight}" HeadersVisibility="Column" SelectionMode="Extended" SelectionUnit="CellOrRowHeader" ClipboardCopyMode="IncludeHeader"
      EnableRowVirtualization="True" EnableColumnVirtualization="True" Background="{DynamicResource ClaySurface}" Foreground="{DynamicResource Ink}" BorderThickness="0"
      RowBackground="{DynamicResource ClaySurface}" AlternatingRowBackground="{DynamicResource ClaySelection}" HorizontalGridLinesBrush="{DynamicResource ClayEdge}" GridLinesVisibility="Horizontal" RowHeaderWidth="0"
      PreviewMouseLeftButtonDown="Grid_MouseDown" PreparingCellForEdit="Grid_PreparingCellForEdit" SelectionChanged="Grid_SelectionChanged" SelectedCellsChanged="Grid_SelectedCellsChanged" PreviewKeyDown="Grid_KeyDown" Loaded="Grid_Loaded">
      <DataGrid.Resources>
       <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="5,0"/><Setter Property="TextAlignment" Value="Right"/></Style>
       <Style x:Key="ReferenceText" TargetType="TextBlock" BasedOn="{StaticResource CellText}"><Setter Property="TextAlignment" Value="Left"/></Style>
       <Style x:Key="CellEditor" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource ClaySurface}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/><Setter Property="SelectionBrush" Value="{DynamicResource ClaySelection}"/><Setter Property="SelectionTextBrush" Value="{DynamicResource Ink}"/>
        <Setter Property="Padding" Value="5,2"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border></ControlTemplate></Setter.Value></Setter>
       </Style>
      </DataGrid.Resources>
      <DataGrid.CellStyle><Style TargetType="DataGridCell">
       <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True"><ContentPresenter VerticalAlignment="Stretch"/></Border></ControlTemplate></Setter.Value></Setter>
       <Style.Triggers>
        <Trigger Property="IsReadOnly" Value="True"><Setter Property="Background" Value="{DynamicResource ClaySelection}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ClaySelection}"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ClayFocus}"/></Trigger>
        <Trigger Property="IsEditing" Value="True"><Setter Property="Background" Value="{DynamicResource ClaySurface}"/><Setter Property="BorderBrush" Value="{DynamicResource ClayFocus}"/></Trigger>
       </Style.Triggers>
      </Style></DataGrid.CellStyle>
      <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Details}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ClaySurface}"/></Trigger></Style.Triggers></Style></DataGrid.RowStyle>
      <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource ClaySelection}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Padding" Value="6,8"/><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGrid.ColumnHeaderStyle>
      <DataGrid.Columns>
       <DataGridTextColumn ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}" Header="Sr No" Binding="{Binding Serial}" IsReadOnly="True" Width="50"/>
       <DataGridTextColumn ElementStyle="{StaticResource ReferenceText}" EditingElementStyle="{StaticResource CellEditor}" Header="Glass Ref" Binding="{Binding GlassRef,UpdateSourceTrigger=PropertyChanged}" Width="1.3*" MinWidth="85"/>
       <DataGridTextColumn ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}" Header="W1" Binding="{Binding W1,UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="65"/>
       <DataGridTextColumn ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}" Header="H1" Binding="{Binding H1,UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="65"/>
       <DataGridTextColumn ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}" Header="W2" Binding="{Binding W2,UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="65"/>
       <DataGridTextColumn ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}" Header="H2" Binding="{Binding H2,UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="65"/>
       <DataGridTextColumn ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}" Header="Qty" Binding="{Binding Qty,UpdateSourceTrigger=PropertyChanged}" Width="60"/>
       <DataGridTextColumn ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}" Header="SQM" Binding="{Binding SqmDisplay}" IsReadOnly="True" Width="75"/>
       <DataGridTextColumn ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}" Header="Total SQM" Binding="{Binding TotalSqmDisplay}" IsReadOnly="True" Width="90"/>
       <DataGridTemplateColumn Header="Price" Width="85" ClipboardContentBinding="{Binding PriceDisplay}"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource CellText}" Text="{Binding PriceDisplay}" ToolTip="{Binding RateHint}"/></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Style="{StaticResource CellEditor}" Text="{Binding Price,UpdateSourceTrigger=PropertyChanged}" ToolTip="Blank uses group base rate"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
       <DataGridTextColumn ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}" Header="Total Price" Binding="{Binding TotalPriceDisplay}" IsReadOnly="True" Width="105"/>
       <DataGridTemplateColumn Header="" Width="45" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="×" Foreground="{DynamicResource ClayDanger}" Click="RemoveRow_Click" Padding="5,1" Margin="0" ToolTip="Remove this row"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
    </Border>
    <DockPanel Margin="0,8,0,0"><WrapPanel DockPanel.Dock="Left"><Button Content="+ Add row" Click="AddRow_Click"/><Button Content="Paste rows" Click="Paste_Click" ToolTip="Append Excel cells with headers, seven input columns or the eleven displayed columns."/></WrapPanel><TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Right"/></DockPanel>
    <TextBlock Text="{Binding ValidationSummary}" Foreground="{DynamicResource ClayDanger}" TextWrapping="Wrap"/>
   </StackPanel></clay:ClayCard>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <TextBlock Text="{Binding Summary}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" Margin="0,4,0,8"/>
  <TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="{DynamicResource ClayDanger}"/>
  <TextBlock Text="Dimensions in mm. SQM = W1 × H1 / 1,000,000 (rounded to 3 decimals); Total SQM = SQM × Qty; Total Price = Total SQM × Price (AED/m²). DGU area is the finished outer unit, not both panes added. W2/H2 both zero or blank reuse W1/H1. Invalid rows remain visible and are excluded from totals." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11"/>
 </StackPanel>
</UserControl>
