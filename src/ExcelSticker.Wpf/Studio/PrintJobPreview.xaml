<UserControl x:Class="ExcelSticker.Wpf.Studio.PrintJobPreview"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:app="clr-namespace:ExcelSticker.Wpf">
 <Grid Margin="8">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="460"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock x:Name="JobSummary" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" Text="Prepare a print job to inspect its exact sticker pages."/>
   <TextBlock x:Name="Freshness" Foreground="{DynamicResource ClayDanger}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4" AutomationProperties.LiveSetting="Polite"/>
   <WrapPanel>
    <Button x:Name="RefreshButton" Content="Refresh preview" Click="Refresh_Click"/>
    <Button x:Name="PrinterButton" Content="Printer setup…" Click="Printer_Click" ToolTip="Choose or change your printer. This setup button does not print stickers."/>
    <Button x:Name="CancelButton" Content="Cancel" Visibility="Collapsed" Click="Cancel_Click"/>
    <TextBlock Text="Screen zoom" VerticalAlignment="Center" Margin="6,0,6,8"/>
    <ComboBox x:Name="Zoom" Width="115" SelectedIndex="4" SelectionChanged="Zoom_Changed" AutomationProperties.Name="Print preview screen zoom"><ComboBoxItem Content="100%"/><ComboBoxItem Content="150%"/><ComboBoxItem Content="200%"/><ComboBoxItem Content="300%"/><ComboBoxItem Content="Fit sticker"/></ComboBox>
   </WrapPanel>
  </StackPanel>
  <WrapPanel Grid.Row="1">
   <Button x:Name="FirstButton" Content="First" Click="First_Click"/><Button x:Name="PreviousButton" Content="← Previous" Click="Previous_Click"/>
   <TextBlock x:Name="Position" VerticalAlignment="Center" Margin="4,0,8,8"/>
   <Button x:Name="NextButton" Content="Next →" Click="Next_Click"/><Button x:Name="LastButton" Content="Last" Click="Last_Click"/>
   <TextBox x:Name="GoToPage" Width="65" MaxLength="5" AutomationProperties.Name="Go to preview page"/><Button x:Name="GoButton" Content="Go" Click="Go_Click"/>
  </WrapPanel>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListBox x:Name="Pages" SelectionChanged="Pages_Changed" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource ClaySurface}" BorderBrush="{DynamicResource ClayEdge}" Margin="0,0,8,0" AutomationProperties.Name="Physical sticker pages in spool order">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ClaySelection}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ClayFocus}"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Caption}" TextWrapping="Wrap" Margin="6"/></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <ScrollViewer x:Name="PageViewport" SizeChanged="Viewport_SizeChanged" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{DynamicResource ClaySelection}">
    <Border x:Name="PaperZoom" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16" BorderBrush="{DynamicResource ClayEdge}" BorderThickness="1" Background="White">
     <Grid x:Name="PaperSize" Width="{x:Static app:LabelView.LabelWidth}" Height="{x:Static app:LabelView.LabelHeight}">
      <ContentControl x:Name="PageHost"/>
      <Canvas x:Name="BoundaryOverlay" IsHitTestVisible="False" ClipToBounds="True"/>
     </Grid>
    </Border>
   </ScrollViewer>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,8,0,0">
   <TextBlock x:Name="PageDetails" TextWrapping="Wrap" FontWeight="SemiBold"/>
   <TextBlock x:Name="PrinterSummary" Text="Choose your printer on first print. It will be remembered." TextWrapping="Wrap" Margin="0,4"/>
   <WrapPanel>
    <Button x:Name="CurrentButton" Content="Print current" Click="Current_Click" IsEnabled="False" Style="{StaticResource Primary}"/>
    <Button x:Name="AllButton" Content="Print all" Click="All_Click" IsEnabled="False"/>
    <TextBlock Text="Range" VerticalAlignment="Center" Margin="4,0,4,8"/>
    <TextBox x:Name="RangeFrom" Text="1" Width="60" MaxLength="5" AutomationProperties.Name="First physical page to print"/><TextBlock Text="to" VerticalAlignment="Center" Margin="4,0,4,8"/>
    <TextBox x:Name="RangeTo" Text="1" Width="60" MaxLength="5" AutomationProperties.Name="Last physical page to print"/><Button x:Name="RangeButton" Content="Print range" Click="Range_Click" IsEnabled="False"/>
   </WrapPanel>
   <TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="{DynamicResource ClayDanger}" AutomationProperties.LiveSetting="Polite"/>
   <Expander x:Name="AdvancedPrint" Header="Advanced" IsExpanded="False">
    <StackPanel Margin="4">
     <CheckBox x:Name="WindowsDriverOnlyBox" Content="Use Windows driver instead of direct ZT411 output" Checked="DriverMode_Changed" Unchecked="DriverMode_Changed"/>
     <CheckBox x:Name="ShowBoundary" Content="Show driver printable-area guide" IsChecked="False" Checked="Boundary_Changed" Unchecked="Boundary_Changed"/>
     <TextBlock x:Name="PrinterDetails" Text="Paper size follows the saved sticker layout. ZT411 direct printing requires ZPL / automatic language recognition. Other printers use their Windows driver." TextWrapping="Wrap" FontSize="11" Margin="0,4"/>
     <TextBlock x:Name="PageWarnings" Foreground="{DynamicResource ClayDanger}" TextWrapping="Wrap"/>
     <TextBlock Text="Load the matching sticker roll and calibrate its gap / black-mark sensor on the printer when changing stock. ZT411 printable width: up to 104 mm. Sensor mode, darkness and speed are not changed by the app. Cancellation cannot undo stickers already printed." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}"/>
    </StackPanel>
   </Expander>
  </StackPanel>
 </Grid>
</UserControl>
